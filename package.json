{
  "name": "kin-blood-network",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @kin/web",
    "dev:api": "npm run dev --workspace @kin/api",
    "worker": "npm run worker --workspace @kin/api",
    "db:migrate": "npm run db:migrate --workspace @kin/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start:api": "npm run start --workspace @kin/api",
    "start:web": "npm run start --workspace @kin/web",
    "start:worker": "npm run start:worker --workspace @kin/api",
    "start:render": "node scripts/start-render.mjs",
    "db:migrate:production": "npm run db:migrate:production --workspace @kin/api"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
